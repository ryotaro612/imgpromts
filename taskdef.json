{
    "family": "qz-edge-api",
    "executionRoleArn": "ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "qz-edge-api",
            "image": "<IMAGE1_NAME>",
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
		"options": {
		  "awslogs-group": "/ecs/qz-edge-api",
		  "awslogs-region":"us-east-1",
		  "awslogs-stream-prefix": "ecs"
		}
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "2048",
    "memory": "4096"
}
