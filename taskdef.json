{
    "family": "hello-server",
    "executionRoleArn": "ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "hello-server-container",
            "image": "644426536299.dkr.ecr.us-east-1.amazonaws.com/hello-server:latest",
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
		"options": {
		  "awslogs-group": "/ecs/hello-server",
		  "awslogs-region":"us-east-1",
		  "awslogs-stream-prefix": "ecs"
		}
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "2048",
    "memory": "4096"
}
